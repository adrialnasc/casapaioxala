---
import Gravura from './Gravura.astro';
const itens = ['velas','folha','cachimbo','coco','capacete','boi','concha','barco','pirulito','pandeiro','galo','rosa'];
---
<div class="friso contido" aria-hidden="true">
  <div class="friso__linha">
    {itens.map((n, i) => <>{i > 0 && <span class="friso__estrela">✦</span>}<Gravura nome={n} largura={56} class={`friso__g ${i % 2 ? 'par' : ''}`} /></>)}
  </div>
</div>
<style>
  .friso { padding-block: var(--esp-bloco); }
  .friso__linha { display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    border-block: 1px solid var(--pedra); padding-block: 1.25rem; overflow: hidden; }
  .friso :global(.friso__g) { width: 48px; height: 48px; flex: none; }
  .friso__estrela { color: var(--ouro); font-size: .75rem; flex: none; }
  @media (max-width: 720px) { .friso :global(.par), .friso__estrela:nth-of-type(2n) { display: none; } }
</style>
