---
import Gravura from './Gravura.astro';
/** Uma linha do calendário de giras. Recebe a gira já descrita (lib/gira.js). */
interface Props { g: any }
const { g } = Astro.props;
const festaAtual = !!g.festa;
---
<li class="lg" data-data={g.data} data-mes={g.mesNum}>
  <p class="lg__data"><span class="subtitulo">{g.dia} {g.mesCurto}</span><span class="rotulo suave">{g.semana}</span></p>
  <span class:list={['lg__med', { 'lg__med--festa': festaAtual }]}><Gravura nome={g.gravura} largura={88} /></span>
  <p class="lg__quem destaque">Atende {g.atende}</p>
  <ul class="chips lg__chips" aria-label="Linhas e avisos">
    <li><span class="chip">{g.linhas.join(' & ')}</span></li>
    {g.aviso && <li><span class="chip chip--alerta">{g.aviso}</span></li>}
    {g.festa && <li><span class="chip chip--ouro">{g.festa}</span></li>}
  </ul>
  <p class="lg__hora titulo-p">{g.hora}</p>
  <a class="lg__cal" href={g.calendario} target="_blank" rel="noopener">+ calendário<span class="sr-only"> da gira de {g.dia} de {g.mes} (abre o Google Agenda)</span></a>
</li>
<style>
  .lg { display: grid; grid-template-columns: 7rem 4rem 1fr auto auto auto; align-items: center; gap: 2rem; padding-block: 1.125rem; border-bottom: 1.5px solid var(--tinta); }
  .lg__data { display: grid; }
  .lg__data .rotulo { font-size: .6875rem; }
  .lg__med { width: 4rem; height: 4rem; border-radius: 50%; border: 1px solid var(--tinta); background: var(--papel-escuro); display: grid; place-items: center; }
  .lg__med--festa { background: var(--ouro); }
  .lg__med :global(.gravura) { width: 2.75rem; }
  .lg__quem { font-weight: 600; }
  .lg__chips { justify-content: flex-end; }
  .lg__chips .chip:not(.chip--ouro):not(.chip--alerta) { color: var(--texto-suave); border-color: var(--tinta); }
  .lg__hora { font-weight: 600; }
  .lg__cal { font-weight: 600; text-decoration: none; padding-block: .75rem; white-space: nowrap; }
  .lg__cal:hover { text-decoration: underline; }
  @media (max-width: 860px) {
    .lg { grid-template-columns: 4rem 1fr; grid-template-areas: 'med data' 'med quem' 'med chips' 'med hora' 'med cal'; gap: .375rem 1rem; align-items: start; padding-block: 1.5rem; }
    .lg__med { grid-area: med; width: 4rem; height: 4rem; }
    .lg__data { grid-area: data; } .lg__quem { grid-area: quem; } .lg__chips { grid-area: chips; justify-content: flex-start; margin-block: .25rem; }
    .lg__hora { grid-area: hora; } .lg__cal { grid-area: cal; padding-block: .5rem; }
  }
</style>
