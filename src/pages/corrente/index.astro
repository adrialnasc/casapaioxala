---
import Base from '../../layouts/Base.astro';
import Botao from '../../components/Botao.astro';
import Gravura from '../../components/Gravura.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import LinhaGira from '../../components/LinhaGira.astro';
import site from '../../data/site.json';
import { agenda, todasGiras, proximaGira, porExtenso, jaPassou } from '../../lib/gira.js';

const L = site.links;
const H = agenda.horarios;
const giras = todasGiras();
const g = proximaGira();
const webcal = `webcal://${new URL(Astro.site!).host}/corrente.ics`;
import { contato } from '../../lib/contato.js';
const linhaParaPontos = (l: string) => ({ Oriente: 'Ritos da Casa', 'Iemanjá': 'Iemanjá', Ogum: 'Ogum', Exu: 'Exus', 'Criança': 'Crianças', Boiadeiro: 'Boiadeiros' } as Record<string, string>)[l];
const prep = [
  { t: 'Antes', itens: ['Resguardo conforme orientação da Casa', 'Banho de ervas', 'Chegar no horário'] },
  { t: 'O que trazer', itens: ['Roupa branca da Casa', 'Guias', 'Toalha e fio de contas'] },
  { t: 'Na Casa', itens: ['Firmeza antes de entrar', 'Silêncio no estudo mediúnico', 'Obedecer ao cambone'] },
];
// Orientações da Ialorixá Magdalena, 1º de março de 1983, como estão no componente "Deveres · abas" do Figma.
const deveres = [
  { aba: 'Com o sagrado', itens: [
    ['01', 'Manter a aura sempre limpa: cultivar a moral, a calma, a educação e a delicadeza, afastar o ódio, a inveja, a cobiça, a vingança e o orgulho, respeitar para ser respeitado e levar o nome de Pai Oxalá acima de tudo.'],
    ['02', 'Acender uma vela para o seu Anjo de Guarda.'],
    ['04', 'Amar e respeitar seus Orixás e Guias, pois são eles que te guiam.'],
    ['10', 'Fazer orações diárias ao Anjo da Guarda, aos Guias e aos Orixás, ao se levantar ou ao se deitar.'],
    ['12', 'Nunca desejar o mal a ninguém nem devolver o mal recebido, pois a lei do retorno não falha.'],
  ] },
  { aba: 'Na gira', itens: [
    ['03', 'Respeitar a roupa de santo e usá-la só no trabalho mediúnico.'],
    ['05', 'Respeitar o horário de início dos trabalhos, pois muitos irmãos precisam acordar cedo no dia seguinte.'],
    ['06', 'Seguir com respeito as orientações do seu Orientador Espiritual, que tem a tarefa de mostrar o bom caminho.'],
    ['07', 'Evitar bebidas alcoólicas, que trazem problemas materiais e espirituais. Nos dias de trabalho, não beber nem comer carne de modo algum.'],
    ['08', 'Estar sempre com o corpo limpo nos dias de trabalho.'],
    ['09', 'Tomar o banho de defesa antes dos trabalhos e sempre que os Guias pedirem.'],
    ['11', 'Respeitar os Exus, sem colocá-los no nível ou à frente dos Orixás, e nunca pedir a eles que façam o mal.'],
  ] },
  { aba: 'No dia a dia', itens: [
    ['13', 'Manter a paz dentro do seu lar, porque assim você ajuda outras pessoas a encontrá-la.'],
    ['14', 'Dar de graça o que de graça Deus lhe deu.'],
    ['15', 'Lembrar que uma pessoa explosiva, mal-educada e sem paciência só suja o nome da Umbanda. Pense nisso e sorria sempre.'],
  ] },
  { aba: 'Com a Casa', intro: 'A Casa é de todos nós. O zelo pela Casa é responsabilidade de toda a corrente, e cada tarefa é vital para a harmonia dos trabalhos.', itens: [
    [null, 'Cuidar do espaço: varrer, passar pano, organizar bancos, cadeiras e materiais de uso comum e recolher o lixo antes do início dos trabalhos.'],
    [null, 'Zelar pelo sagrado: manter o congá, os assentamentos e os pontos de força em ordem, sem tocar em nada sem orientação.'],
    [null, 'Preparar a gira: deixar o defumador e as velas prontos e, depois, ajudar a organizar o que foi usado.'],
    [null, 'Olhar o que falta: conferir velas, pólvora, ervas, carvão e produtos de limpeza e avisar o grupo com antecedência.'],
    [null, 'Cumprir a escala: quem não puder vir avisa a Mãe de Santo e combina a troca com um irmão.'],
    [null, 'Respeitar os irmãos: respeitar todos os irmãos da Casa e orar pelos que estão perturbados.'],
    [null, 'Nenhuma função vale mais: cambone, curimbeiro ou médium de incorporação, todos têm responsabilidades e merecem o mesmo respeito.'],
    [null, 'Dias de festa: atenção redobrada, porque o movimento é maior.'],
  ] },
];
// Biblioteca de estudos (antes na página /estudos/). Cada livro vira um cartão; o 3º item é o link, o 4º o rótulo.
const biblio = [
  { t: 'Umbanda', g: ['cachimbo', 'espada', 'velas', 'charuto', 'folha'], livros: [['Conhecendo a Umbanda: Dentro do Terreiro', 'Douglas Rainho'], ['O Espiritismo, a Magia e as Sete Linhas de Umbanda', 'Leal de Souza'], ['Umbanda de Todos Nós', 'W. W. da Matta e Silva'], ['Lições de Umbanda e Quimbanda na Palavra de um Preto Velho', 'W. W. da Matta e Silva'], ['Fogo no Mato: A Ciência Encantada das Macumbas', 'Luiz Antônio Simas e Luiz Rufino']] },
  { t: 'Orixás e ancestralidade', g: ['concha', 'barco', 'sol', 'coco', 'galo', 'espada'], livros: [['Mitologia dos Orixás', 'Reginaldo Prandi'], ['Encantaria Brasileira', 'Reginaldo Prandi'], ['Candomblé Bem Explicado', 'Odé Kileuy e Vera de Oxaguiã'], ['Bantos, Malês e Identidade Negra', 'Nei Lopes'], ['A Terra dos Mil Povos', 'Kaká Werá'], ['São Jorge: O santo do povo e o povo do santo', 'Luiz Antônio Simas', 'https://proassets.planetadelivros.com.br/usuaris/libros_contenido/arxius/66/65102_1_978-85-422-4060-3.pdf', 'Livro · trecho em PDF']] },
  { t: 'Mediunidade', g: ['velas', 'nuvem', 'lua', 'crescente'], livros: [['O Livro dos Médiuns', 'Allan Kardec', 'https://download.espiritismo.net/literatura_espirita/WEB-O-Livro-dos-Mediuns-Guillon.pdf', 'PDF'], ['Apostila de mediunidade', 'Casa Pai Oxalá', '', 'Apostila · em breve', true], ['Nos Domínios da Mediunidade', 'André Luiz e Chico Xavier'], ['Diálogo com as Sombras', 'Hermínio C. Miranda']] },
  { t: 'Ervas e benzimento', g: ['ramo', 'folha', 'rosa'], livros: [['As Ervas na Umbanda', 'Douglas Rainho'], ['O Poder das Ervas na Umbanda', 'José Ribeiro'], ['Rituais com Ervas: Banhos, Defumações e Benzimentos', 'Adriano Camargo']] },
];
const nLivros = biblio.reduce((n, b) => n + b.livros.filter((l) => !l[4]).length, 0);
const prateleiras = [
  { t: 'Da Casa', itens: [
    { rot: 'Apresentação', t: 'Conhecendo a Umbanda', a: 'Casa Pai Oxalá', h: L.apresentacao, g: 'velas' },
    { rot: 'Caderno · NotebookLM', t: 'Caderno de estudos da Casa', a: 'Perguntas, resumos em áudio e mapas mentais', h: L.caderno, g: 'folha' },
    { rot: 'Vídeo · 8 min', t: 'Espiritualismo e Umbanda', a: 'Resumo gerado por IA a partir do caderno', h: L.cadernoVideo, g: 'lua' },
    { rot: 'Caderno · em preparação', t: 'Caderno de ervas', a: 'Nomes, usos e cuidados de cada erva', h: '/corrente/ervas/', g: 'ramo' },
  ] },
  ...biblio.map((b) => ({ t: b.t, itens: b.livros.map(([t, a, h, rot], i) => ({ rot: rot || 'Livro', t, a, h, g: b.g[i % b.g.length] })) })),
];
// Painel no topo: atalhos com o estado de cada coisa.
const futuras = giras.filter((x) => !jaPassou(x.data));
const calStatus = futuras.length ? `${futuras.length} ${futuras.length === 1 ? 'gira' : 'giras'} até ${futuras.at(-1).mes.toLowerCase()}` : 'Sem giras marcadas';
const nPrep = prep.reduce((n, p) => n + p.itens.length, 0);
const painel = [
  { t: 'Preparação', s: `0 de ${nPrep}`, h: '#preparacao', g: 'ramo', campo: 'prep' },
  { t: 'Deveres', s: 'e o Manual do médium', h: '#deveres', g: 'velas' },
  { t: 'Calendário', s: calStatus, h: '#calendario', g: 'crescente', campo: 'cal' },
  { t: 'Pontos', s: 'Livro e playlists', h: '/pontos/', g: 'atabaque' },
  { t: 'Orações', s: '3 orações', h: '/oracoes/', g: 'rosa' },
  { t: 'Bibliografia', s: `${nLivros} livros`, h: '#estudar', g: 'concha' },
];
const estrelas = Array.from({ length: 46 }, (_, i) => ({ x: (i * 37.7) % 100, y: (i * 53.3) % 100, s: 8 + ((i * 7) % 14) }));
---
<Base restrito titulo="Corrente · Casa de Umbanda Pai Oxalá" descricao="O que os médiuns da Casa de Umbanda Pai Oxalá precisam no dia a dia: preparação, calendário, pontos e estudos.">
  <Cabecalho tema="t-noite" titulo="Para a <em>corrente</em>" lead="O que os médiuns da Casa precisam no dia a dia: preparação, calendário, pontos e estudos.">
    <div slot="deco" class="cab__deco co-ceu" aria-hidden="true">
      {estrelas.map((e) => <span style={`left:${e.x}%;top:${e.y}%;font-size:${e.s}px`}>✦</span>)}
      <Gravura nome="crescente" largura={480} class="co-lua" eager />
    </div>
  </Cabecalho>

  <nav class="contido painel" aria-label="Nesta página">
    <ul class="painel__grade">
      {painel.map((p) => (
        <li><a class="cartao painel__c" href={p.h}>
          <span class="painel__ico"><Gravura nome={p.g} largura={80} /></span>
          <span class="painel__t">{p.t}</span>
          <span class="painel__s" data-painel={p.campo}>{p.s}</span>
        </a></li>
      ))}
    </ul>
  </nav>

  {g && (
    <section class="contido co-prox" aria-labelledby="co-prox-t">
      <article class="cartao co-prox__card" data-proxima>
        <span class="co-prox__barra" aria-hidden="true"></span>
        <div class="co-prox__txt">
          <h2 id="co-prox-t" class="titulo" data-campo="extenso">{porExtenso(g)}</h2>
          <p class="leitura">Chegada dos médiuns {H.chegadaMediuns} · Estudo mediúnico {H.estudo} · Gira {H.gira} · <span data-campo="resumo">{g.linhas.join(' e ')}, atende {g.atende}</span></p>
        </div>
        <div class="co-prox__btns">
          {linhaParaPontos(g.linhas[0]) && <Botao href={`/pontos/#${linhaParaPontos(g.linhas[0])!.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z]+/g, '-').replace(/-$/, '')}`} variante="papel">Pontos de {g.linhas[0]} →</Botao>}
          <Botao href="#preparacao" variante="papel">Checklist</Botao>
        </div>
      </article>
    </section>
  )}

  <section id="preparacao" class="secao t-papel-escuro co-prep" aria-labelledby="prep-t">
    <div class="contido">
      <h2 id="prep-t" class="titulo">Preparação para a <em>gira</em></h2>
      <ul class="grade grade--3 prep">
        {prep.map((p, i) => (
          <li class="cartao"><fieldset><legend class="subtitulo">{p.t}</legend>
            {p.itens.map((it, j) => <label class="check"><input type="checkbox" name={`prep-${i}-${j}`} /><span>{it}</span></label>)}
          </fieldset></li>
        ))}
      </ul>
      <p class="nota suave prep__nota">As marcações ficam só neste aparelho e servem para você se organizar.</p>
    </div>
  </section>

  <section id="deveres" class="secao" aria-labelledby="dev-t">
    <div class="contido">
      <p class="rotulo dev__fonte">Orientações da Ialorixá Magdalena · 1º de março de 1983</p>
      <h2 id="dev-t" class="titulo">Deveres de um <em>bom médium</em></h2>
      <p class="nota suave dev__num">A numeração segue o Manual do médium.</p>
      <div class="dev">
        <div class="abas">
          <div class="chips" role="tablist" aria-label="Deveres">
            {deveres.map((d, i) => <button type="button" role="tab" class="chip" id={`aba-${i}`} aria-controls={`painel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{d.aba}</button>)}
          </div>
          {deveres.map((d, i) => (
            <div role="tabpanel" id={`painel-${i}`} aria-labelledby={`aba-${i}`} hidden={i !== 0} tabindex="0">
              {d.intro && <p class="dev__intro">{d.intro}</p>}
              <ol class="deveres">{d.itens.map(([n, t]) => <li><span class={n ? 'dev__n' : 'dev__n dev__n--estrela'} aria-hidden="true">{n ?? '✦'}</span><span>{n && <span class="sr-only">Dever {Number(n)}: </span>}{t}</span></li>)}</ol>
            </div>
          ))}
        </div>
        <aside class="manual cartao cartao--escuro" aria-labelledby="manual-t">
          <Gravura nome="velas" largura={160} class="manual__g" />
          <p class="rotulo manual__rot">PDF · só para a corrente</p>
          <h3 id="manual-t" class="titulo-p">Manual do médium</h3>
          <p class="suave">Roupa, guias, frequência e as orientações da Casa para quem está na corrente, num arquivo para guardar no celular.</p>
          {L.manualMedium ? <Botao href={L.manualMedium} variante="tinta" externo>Baixar o manual ↓</Botao> : <p class="em-breve">Peça o manual à Casa</p>}
          <p class="nota suave"><em>O arquivo pede a senha do grupo da corrente.</em></p>
        </aside>
      </div>
    </div>
  </section>

  <section id="calendario" class="secao secao--sem-topo" aria-labelledby="cc-t">
    <div class="contido">
      <div class="secao__topo cc-topo"><h2 id="cc-t" class="titulo">Calendário da <em>corrente</em></h2><Botao href={webcal} variante="papel">Assinar no meu celular</Botao></div>
      <ul class="lista-giras" data-futuras>{giras.map((x) => <LinhaGira g={x} corrente oculta={jaPassou(x.data)} />)}</ul>
    </div>
  </section>

  <section id="estudar" class="secao t-noite" aria-labelledby="ec-t">
    <div class="contido">
      <h2 id="ec-t" class="titulo">Estudar em <em class="ouro">casa</em></h2>
      <p class="leitura secao__lead est__lead">Nenhum livro substitui a vivência, os fundamentos e a orientação dos mais velhos da Casa. Leia com senso crítico.</p>
      {prateleiras.map((p, k) => (
        <div class="prat" role="group" aria-labelledby={`prat-${k}`}>
          <h3 id={`prat-${k}`} class="subtitulo prat__t">{p.t} <span class="rotulo ouro">{p.itens.length} {p.itens.length === 1 ? 'item' : 'itens'}</span></h3>
          <ul class="prat__lista">
            {p.itens.map((e) => {
              const corpo = <><span class="rotulo est__rot">{e.rot}</span><Gravura nome={e.g} largura={120} class="est__g" /><span class="est__t">{e.t}</span><span class="nota suave-tinta">{e.a}</span></>;
              return <li>{e.h ? (e.h.startsWith('http') ? <a class="cartao est" href={e.h} target="_blank" rel="noopener">{corpo}<span class="sr-only"> (abre em nova aba)</span></a> : <a class="cartao est" href={e.h}>{corpo}</a>) : <div class="cartao est est--sem">{corpo}</div>}</li>;
            })}
          </ul>
        </div>
      ))}
      <p class="nota est__fonte">Para uma lista mais extensa, veja a <a href="https://perdido.co/2019/09/bibliografia-recomendada/" target="_blank" rel="noopener">bibliografia de Douglas Rainho<span class="sr-only"> (abre em nova aba)</span></a> no portal Perdido em Pensamentos.</p>
    </div>
  </section>

  <section class="secao" aria-labelledby="gf-t">
    <div class="contido">
      <div class="fechado t-noite">
        <div><h2 id="gf-t" class="subtitulo">O que fica só no grupo da corrente</h2>
          <p class="leitura">Atas completas, escalas, nomes, orientações individuais e avisos internos. A entrada no grupo é combinada com a Casa.</p></div>
        <Botao href={contato.href} variante="papel" externo={contato.externo}>{contato.rotulo}</Botao>
      </div>
    </div>
  </section>
</Base>

<script>
  import { proximaGira, porExtenso, jaPassou } from '../../lib/gira.js';
  document.querySelectorAll<HTMLElement>('[data-futuras] > li').forEach((li) => { li.hidden = jaPassou(li.dataset.data!); });
  const g = proximaGira(); const card = document.querySelector('[data-proxima]');
  if (g && card) {
    const e = card.querySelector('[data-campo="extenso"]'); if (e) e.textContent = porExtenso(g);
    const r = card.querySelector('[data-campo="resumo"]'); if (r) r.textContent = `${g.linhas.join(' e ')}, atende ${g.atende}`;
  }
  // checklist guardado só no aparelho
  document.querySelectorAll<HTMLInputElement>('.check input').forEach((c) => {
    try { c.checked = localStorage.getItem('corrente:' + c.name) === '1'; } catch {}
    c.addEventListener('change', () => { try { localStorage.setItem('corrente:' + c.name, c.checked ? '1' : '0'); } catch {} });
  });
  // painel: quantos itens da preparação estão marcados e quantas giras faltam
  const marcar = () => {
    const cx = [...document.querySelectorAll<HTMLInputElement>('.check input')];
    const el = document.querySelector('[data-painel="prep"]'); if (el) el.textContent = `${cx.filter((c) => c.checked).length} de ${cx.length}`;
  };
  marcar(); document.querySelectorAll('.check input').forEach((c) => c.addEventListener('change', marcar));
  const vis = [...document.querySelectorAll<HTMLElement>('[data-futuras] > li')].filter((li) => !li.hidden);
  const cal = document.querySelector('[data-painel="cal"]');
  if (cal) {
    const MES = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
    const ult = vis.at(-1)?.dataset.mes;
    cal.textContent = vis.length && ult ? `${vis.length} ${vis.length === 1 ? 'gira' : 'giras'} até ${MES[Number(ult)]}` : 'Sem giras marcadas';
  }
  // abas dos deveres
  const abas = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const ativar = (a: HTMLButtonElement) => {
    abas.forEach((x) => { const on = x === a; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on; });
  };
  abas.forEach((a, i) => {
    a.addEventListener('click', () => ativar(a));
    a.addEventListener('keydown', (ev) => {
      const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0; if (!d) return;
      const n = abas[(i + d + abas.length) % abas.length]; ativar(n); n.focus(); ev.preventDefault();
    });
  });
</script>

<style>
  .co-ceu { inset: 0; }
  .co-ceu span { position: absolute; color: var(--ouro-claro); line-height: 1; opacity: .8; }
  .co-ceu :global(.co-lua) { position: absolute; right: 2%; top: 50%; transform: translateY(-50%); width: min(36vw, 523px); }
  .co-prox { padding-top: var(--esp-colada); }
  .co-prox__card { display: grid; grid-template-columns: auto 1fr auto; gap: 2.5rem; align-items: center; padding: 2rem 1.75rem; }
  .co-prox__barra { width: 14px; align-self: stretch; background: var(--vermelho); }
  .co-prox__txt { display: grid; gap: .5rem; }
  .co-prox__btns { display: flex; gap: .5rem; flex-wrap: wrap; }
  .co-prep { margin-top: var(--esp-secao); }
  .prep { margin-top: var(--esp-bloco); }
  .prep fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .prep legend { font-weight: 600; margin-bottom: .75rem; padding: 0; }
  .check { display: grid; grid-template-columns: 1.25rem 1fr; gap: .625rem; align-items: start; cursor: pointer; min-height: 1.75rem; }
  .check input { appearance: none; width: 1.125rem; height: 1.125rem; margin: .25rem 0 0; border: 1.5px solid var(--tinta); background: var(--papel); display: grid; place-items: center; cursor: pointer; }
  .check input:checked { background: var(--tinta); }
  .check input:checked::after { content: '✓'; color: var(--papel); font-size: .75rem; line-height: 1; }
  .check input:checked + span { text-decoration: line-through; color: var(--texto-suave); }
  .prep__nota { margin-top: var(--esp-grupo); }
  .dev__fonte { color: var(--vermelho); margin-bottom: 1rem; }
  .dev { display: grid; grid-template-columns: 720fr 400fr; gap: 5rem; margin-top: var(--esp-bloco); align-items: start; }
  .abas [role="tab"] { color: var(--tinta); }
  .abas [role="tab"][aria-selected="true"] { background: var(--tinta); color: var(--papel); }
  .deveres { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; gap: 1.5rem; }
  .deveres li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; font-size: var(--t-destaque-p); line-height: 1.5; }
  .dev__n { font-size: var(--t-subtitulo); font-style: italic; font-weight: 600; color: var(--vermelho); line-height: 1.1; }
  .dev__n--estrela { font-style: normal; font-size: var(--t-destaque-p); line-height: 1.5; }
  .dev__intro { margin: 2.25rem 0 0; max-width: 40rem; font-style: italic; font-size: var(--t-destaque-p); line-height: 1.5; }
  .manual { display: grid; gap: 1rem; justify-items: start; padding: 2rem; box-shadow: var(--sombra-p); border-width: 1px; }
  .manual :global(.manual__g) { width: 7.5rem; }
  .manual__rot { color: var(--vermelho); }
  .lista-giras { list-style: none; padding: 0; margin: 0; }
  .painel { padding-top: var(--esp-colada); }
  .painel__grade { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
  .painel__c { display: grid; gap: .5rem; align-content: start; height: 100%; padding: 1.25rem; text-decoration: none; box-shadow: var(--sombra-p); }
  a.painel__c:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--tinta); }
