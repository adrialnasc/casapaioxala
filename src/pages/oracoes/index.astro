---
import Base from '../../layouts/Base.astro';
import Gravura from '../../components/Gravura.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import livro from '../../data/pontos.json';

// A Prece de Cáritas vem do Livro de Pontos (Ritos da Casa, 04), para não existir em dois lugares.
const ritos = (livro as any[]).find((l) => l.nome === 'Ritos da Casa');
const caritas = ritos?.pontos.find((p: any) => p.titulo === 'Prece de Cáritas');

// Pai Nosso e Ave Maria: versões tradicionais em português, de domínio público.
// A confirmar com a Casa se são as versões rezadas na gira.
type Oracao = { id: string; t: string; quando: string; lema: string; estrofes: string[][]; youtube?: string; breve?: boolean };
const oracoes: Oracao[] = [
  { id: 'prece-de-caritas', t: 'Prece de Cáritas', quando: 'Abre a gira', lema: 'A prece que abre os trabalhos da Casa.',
    estrofes: caritas ? caritas.estrofes : [], youtube: caritas?.youtube },
  { id: 'pai-nosso', t: 'Pai Nosso', quando: 'Na gira e em casa', lema: 'Para rezar junto na gira e em casa.', estrofes: [[
    'Pai nosso que estais nos céus,', 'santificado seja o vosso nome;', 'venha a nós o vosso reino;',
    'seja feita a vossa vontade,', 'assim na terra como no céu.', 'O pão nosso de cada dia nos dai hoje;',
    'perdoai-nos as nossas ofensas,', 'assim como nós perdoamos', 'a quem nos tem ofendido;',
    'e não nos deixeis cair em tentação,', 'mas livrai-nos do mal.', 'Amém.']] },
  { id: 'ave-maria', t: 'Ave Maria', quando: 'Na gira e em casa', lema: 'Para rezar junto na gira e em casa.', estrofes: [[
    'Ave Maria, cheia de graça,', 'o Senhor é convosco;', 'bendita sois vós entre as mulheres,',
    'e bendito é o fruto do vosso ventre, Jesus.', 'Santa Maria, Mãe de Deus,', 'rogai por nós, pecadores,',
    'agora e na hora de nossa morte.', 'Amém.']] },
  { id: 'oracao-de-sao-jorge', t: 'Oração de São Jorge', quando: 'Para proteção', lema: 'Para pedir a proteção de São Jorge.', youtube: 'pzFfYwgk3gg', estrofes: [
    ['Eu andarei vestido e armado com as armas de São Jorge para que meus inimigos tendo pés, não me alcancem; tendo mãos, não me peguem; tendo olhos não me vejam e nem em pensamentos eles possam me fazer mal.'],
    ['Armas de fogo o meu corpo não alcançarão, facas e lanças se quebrem sem o meu corpo tocar, cordas e correntes se arrebentem sem o meu corpo amarrar.'],
    ['Jesus Cristo me proteja e me defenda com o poder de sua santa e divina graça, Virgem de Nazaré me cubra com o seu manto sagrado e divino, protegendo-me em todas as minhas dores e aflições, e Deus com sua Divina Misericórdia e grande poder seja meu defensor contra as maldades e perseguições dos meus inimigos.'],
    ['Glorioso São Jorge, em nome de Deus, estenda-me o seu escudo e as suas poderosas armas, defendendo-me com a sua força e com a sua grandeza, e que debaixo das patas de seu fiel ginete meus inimigos fiquem humildes e submissos a vós.'],
    ['Assim seja com o poder de Deus, de Jesus e da falange do Divino Espírito Santo.']] },
];
const inicial = oracoes[0].id;
// Playlist "Casa de Umbanda Pai Oxalá Orações e Rezos" no YouTube da Casa.
const PLAYLIST = 'PLbB1ulc3sfAQ';
const yt = (id: string) => `https://www.youtube.com/watch?v=${id}&list=${PLAYLIST}`;
---
<Base titulo="Orações · Casa de Umbanda Pai Oxalá" descricao="As orações rezadas na Casa de Umbanda Pai Oxalá: Prece de Cáritas, Pai Nosso e Ave Maria, para rezar junto na gira e em casa.">
  <Cabecalho tema="t-vermelho" titulo="Orações <em>da Casa</em>" lead="Para rezar junto na gira e em casa. A Prece de Cáritas abre os trabalhos.">
    <Gravura slot="deco" nome="velas" largura={480} class="cab__deco or-velas" eager />
  </Cabecalho>

  <section id="oracoes" class="secao secao--colada" aria-labelledby="or-t">
    <div class="contido">
      <div class="or-cab">
        <h2 id="or-t" class="titulo">Livro de <em>orações</em></h2>
        <p class="suave">{oracoes.filter((o) => !o.breve).length} orações rezadas na Casa. A Prece de Cáritas também está no <a href="/pontos/#ritos-da-casa">Livro de Pontos</a>, em Ritos da Casa.</p>
      </div>
      <div class="livro">
        <nav class="linhas cartao cartao--escuro" aria-label="Orações" id="lista">
          <p class="rotulo suave">Orações</p>
          <ul>
            {oracoes.map((o) => <li><a href={`#${o.id}`} class="linha" data-or={o.id} aria-current={o.id === inicial ? 'true' : undefined}><span>{o.t}</span>{o.breve && <span class="linha__n">em breve</span>}</a></li>)}
          </ul>
          <a class="seta or-pl" href={`https://www.youtube.com/playlist?list=${PLAYLIST}`} target="_blank" rel="noopener">Playlist de orações no YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>
          <div class="or-tam-grupo" role="group" aria-label="Tamanho do texto">
            <span class="rotulo suave">Tamanho do texto</span>
            <span class="or-tam-btns">
              <button type="button" class="or-tam" data-tam="-1" aria-label="Diminuir o texto">A−</button>
              <button type="button" class="or-tam" data-tam="1" aria-label="Aumentar o texto">A+</button>
            </span>
          </div>
        </nav>
        <div class="livro__conteudo" data-or-lista>
          {oracoes.map((o) => (
            <article id={o.id} class="painel" data-painel={o.id} hidden={o.id !== inicial} aria-labelledby={`${o.id}-t`}>
              <p class="rotulo painel__rot">{o.quando}</p>
              <h3 id={`${o.id}-t`} class="titulo painel__t">{o.t}</h3>
              <p class="leitura suave painel__lema">{o.lema}</p>
              {!o.breve && (
                <>
                  <div class="or__acoes">
                    {o.youtube && <a class="seta" href={yt(o.youtube)} target="_blank" rel="noopener">Ouvir no YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>}
                    <button type="button" class="seta or__copiar" data-copiar={o.id}>Copiar a oração</button>
                  </div>
                  <div class="or__texto">
                    {o.estrofes.map((e) => <p class="leitura or__estrofe">{e.map((v, j) => <>{j > 0 && <br />}{v}</>)}</p>)}
                  </div>
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-or]');
  const paineis = document.querySelectorAll<HTMLElement>('[data-painel]');
  function mostrar(id: string, rolar = false) {
    const alvo = document.querySelector<HTMLElement>(`[data-painel="${id}"]`); if (!alvo) return false;
    links.forEach((x) => x.dataset.or === id ? x.setAttribute('aria-current', 'true') : x.removeAttribute('aria-current'));
    paineis.forEach((p) => { p.hidden = p !== alvo; });
    if (rolar) alvo.scrollIntoView({ behavior: 'smooth', block: 'start' });
    return true;
  }
  links.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); mostrar(a.dataset.or!, matchMedia('(max-width: 860px)').matches);
    history.replaceState(null, '', '#' + a.dataset.or);
  }));
  const abrirHash = () => { const h = location.hash.slice(1); if (h && mostrar(h)) document.getElementById('oracoes')?.scrollIntoView(); };
  abrirHash(); window.addEventListener('hashchange', abrirHash);

  const lista = document.querySelector<HTMLElement>('[data-or-lista]')!;
  const passos = [1, 1.15, 1.3, 1.5];
  let i = 0;
  try { i = Math.min(passos.length - 1, Math.max(0, Number(localStorage.getItem('oracoes-tam') || 0))); } catch {}
  const aplicar = () => { lista.style.setProperty('--or-escala', String(passos[i])); };
  aplicar();
  document.querySelectorAll<HTMLButtonElement>('[data-tam]').forEach((b) => b.addEventListener('click', () => {
    i = Math.min(passos.length - 1, Math.max(0, i + Number(b.dataset.tam)));
    aplicar(); try { localStorage.setItem('oracoes-tam', String(i)); } catch {}
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => b.addEventListener('click', async () => {
    const art = document.getElementById(b.dataset.copiar!)!;
    const titulo = art.querySelector('h3')?.textContent || '';
    const texto = Array.from(art.querySelectorAll<HTMLElement>('.or__estrofe')).map((p) => p.innerText).join('\n\n');
    try { await navigator.clipboard.writeText(`${titulo}\n\n${texto}`); b.textContent = 'Copiada'; }
    catch { b.textContent = 'Não foi possível copiar'; }
    setTimeout(() => { b.textContent = 'Copiar a oração'; }, 2000);
  }));
</script>

<style>
  :global(.or-velas) { right: 2%; top: 50%; transform: translateY(-50%); width: min(36vw, 420px); mix-blend-mode: screen; filter: grayscale(1) invert(1) brightness(.9); opacity: .35; }
  /* mesmo desenho do Livro de pontos */
  .or-cab { margin-bottom: var(--esp-bloco); display: grid; gap: .5rem; }
  .livro { display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start; }
  .linhas { padding: 1.75rem; position: sticky; top: 6rem; }
  .linhas ul { list-style: none; padding: 0; margin: .75rem 0 0; display: grid; gap: .25rem; }
  .linha { display: flex; justify-content: space-between; align-items: center; gap: .5rem; width: 100%; color: var(--tinta); text-decoration: none; padding: .625rem .75rem; min-height: 2.75rem; }
  .linha:hover { background: color-mix(in srgb, var(--papel) 60%, transparent); }
  .linha[aria-current] { background: var(--papel); font-weight: 600; }
  .linha__n { font: 500 .75rem var(--mono); color: var(--texto-suave); }
  .or-pl { margin-top: 1rem; }
  .or-tam-grupo { display: grid; gap: .5rem; margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--pedra); }
  .or-tam-btns { display: flex; gap: .5rem; }
  .or-tam { min-width: 44px; min-height: 44px; font: 600 1rem var(--serif); color: var(--tinta); background: var(--papel); border: 1.5px solid var(--tinta); cursor: pointer; }
  .or-tam:hover { background: var(--tinta); color: var(--papel); }
  .livro__conteudo { --or-escala: 1; min-width: 0; }
  .painel { scroll-margin-top: 6rem; }
  .painel__rot { color: var(--vermelho); margin-bottom: .5rem; }
  .painel__t { margin-bottom: .5rem; }
  .painel__lema { margin-bottom: .75rem; max-width: 40rem; }
  .or__acoes { display: flex; gap: 1.5rem; flex-wrap: wrap; padding-bottom: .5rem; border-bottom: 1.5px solid var(--tinta); }
  .or__copiar { background: none; border: 0; color: inherit; cursor: pointer; padding-inline: 0; }
  .or__texto { padding-top: 1.25rem; max-width: 44rem; }
  .or__estrofe { font-size: calc(var(--t-leitura) * var(--or-escala)); line-height: 1.6; }
  .or__estrofe + .or__estrofe { margin-top: .75rem; }
  @media (max-width: 860px) {
    :global(.or-velas) { display: none; }
    .livro { grid-template-columns: 1fr; }
    .linhas { position: static; padding: 1.25rem; }
    .linhas ul { grid-template-columns: 1fr 1fr; gap: .5rem; }
    .linha { font-size: .9375rem; padding: .5rem; }
    .linha__n { display: none; }
    .or-tam-grupo { grid-auto-flow: column; justify-content: space-between; align-items: center; }
  }
</style>
