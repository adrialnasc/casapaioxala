---
import Base from '../../layouts/Base.astro';
import Botao from '../../components/Botao.astro';
import Gravura from '../../components/Gravura.astro';
import site from '../../data/site.json';

const L = site.links;
const roda = ['velas', 'folha', 'cachimbo', 'coco', 'capacete', 'boi', 'concha', 'barco', 'pirulito', 'pandeiro', 'galo', 'rosa'];
const grupos = [
  { quem: 'Todos', t: 'Avisos da Casa', d: 'Só a Casa escreve. Próxima gira, mudanças de data, festas e novos materiais.' },
  { quem: 'Quem quiser estudar', t: 'Estudos', d: 'Conversa sobre apresentações, livros e o caderno de estudos.' },
  { quem: 'Só médiuns da Casa', t: 'Corrente', d: 'Grupo fechado. Material interno fica aqui, fora do site.' },
];
const recebe = [
  { t: 'Lembrete da gira', d: 'Na véspera, com horário e a linha do dia.', img: 'cal' },
  { t: 'Mudanças na agenda', d: 'Se uma data mudar, você fica sabendo antes.', img: 'cal' },
  { t: 'Novo material de estudo', d: 'Apresentações e textos assim que entram no site.', g: 'folha' },
  { t: 'Nova playlist', d: 'Pontos e músicas para ouvir e aprender.', g: 'atabaque' },
];
const regras = ['Respeito a todas as tradições e casas', 'Nada de exposição de médiuns, fotos de gira ou consultas', 'Endereço só por mensagem privada com a Casa', 'Dúvidas espirituais pessoais: fale com a Casa, não no grupo'];
---
<Base titulo="Comunidade no WhatsApp · Casa de Umbanda Pai Oxalá" descricao="A comunidade da Casa de Umbanda Pai Oxalá no WhatsApp: avisos de gira, novos materiais de estudo e playlists, direto no celular.">
  <header class="cab t-tinta cm-cab" aria-labelledby="pagina-t">
    <div class="contido cm-cab__in">
      <div class="cab__in">
        <h1 id="pagina-t" class="cab__titulo cm-titulo">Comunidade da Casa no <em>WhatsApp</em></h1>
        <p class="leitura cab__lead suave">Um lugar para receber os avisos da Casa e estudar junto, sem virar bate-papo sem fim.</p>
        {L.comunidade ? <div class="cab__acoes cm-so-celular"><Botao href={L.comunidade} externo>Entrar na comunidade</Botao></div> : <p class="em-breve cm-so-celular cm-breve">O link da comunidade entra aqui em breve</p>}
      </div>
      <div class="cm-roda">
        <ul class="cm-roda__itens" aria-hidden="true">
          {roda.map((n, i) => <li style={`--i:${i}`}><Gravura nome={n} largura={88} /></li>)}
        </ul>
        <div class="cm-qr">
          {L.comunidade ? (
            <a href={L.comunidade} target="_blank" rel="noopener" class="cm-qr__link"><img src="/qr-comunidade.svg" width="240" height="240" alt="QR code da comunidade da Casa no WhatsApp" /><span class="sr-only"> (abre o WhatsApp)</span></a>
          ) : (
            <span class="cm-qr__vazio"><span class="rotulo">QR code</span><span class="nota">em breve</span></span>
          )}
          <p class="rotulo suave-tinta">Aponte a câmera do celular</p>
        </div>
      </div>
    </div>
  </header>

  <section class="secao secao--colada t-papel-escuro" aria-labelledby="org-t">
    <div class="contido">
      <h2 id="org-t" class="titulo">Como a comunidade se <em>organiza</em></h2>
      <ul class="grade grade--3 org">
        {grupos.map((x) => <li class="cartao org__c"><span class="chip">{x.quem}</span><h3 class="subtitulo">{x.t}</h3><p class="suave">{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="secao t-tinta" aria-labelledby="rec-t">
    <div class="contido">
      <h2 id="rec-t" class="titulo">O que chega no seu <em>celular</em></h2>
      <ul class="grade grade--4 rec">
        {recebe.map((x) => <li class="rec__c">{x.img ? <img src="/gravuras/calendario.png" alt="" width="64" height="64" /> : <Gravura nome={x.g!} largura={120} />}<h3 class="destaque">{x.t}</h3><p class="suave-tinta">{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="secao t-papel-escuro" aria-labelledby="reg-t">
    <div class="contido">
      <h2 id="reg-t" class="titulo">Regras de <em>convivência</em></h2>
      <ul class="estrelas regras">{regras.map((r) => <li>{r}</li>)}</ul>
      <div class="cm-banner">
        <span class="cm-banner__estrela" aria-hidden="true">✦</span>
        <div><p class="rotulo kicker">Comunidade no WhatsApp</p><p class="titulo">Fique <em>por perto.</em></p><p>Avisos de gira, novos materiais de estudo e playlists, direto no celular.</p></div>
        {L.comunidade ? <Botao href={L.comunidade} externo>Entrar na comunidade</Botao> : <p class="em-breve">O link da comunidade entra aqui em breve</p>}
      </div>
    </div>
  </section>
</Base>

<style>
  .cm-so-celular { display: none; }
  .cm-cab__in { display: grid; grid-template-columns: 1fr 380px; gap: var(--esp-bloco); align-items: center; }
  .cm-titulo { max-width: 13ch; }
  .cm-roda { position: relative; width: 380px; aspect-ratio: 1; display: grid; place-items: center; margin-block: var(--esp-faixa); }
  .cm-roda::before { content: ''; position: absolute; inset: 12%; border: 1px dashed var(--ouro-claro); border-radius: 50%; opacity: .6; }
  .cm-roda__itens { list-style: none; padding: 0; margin: 0; position: absolute; inset: 0; }
  .cm-roda__itens li { position: absolute; left: 50%; top: 50%; width: 4.25rem; height: 4.25rem; margin: -2.125rem; border-radius: 50%; background: var(--papel); display: grid; place-items: center;
    transform: rotate(calc(var(--i) * 30deg - 90deg)) translate(165px) rotate(calc(var(--i) * -30deg + 90deg)); }
  .cm-roda__itens :global(.gravura) { width: 70%; }
  .cm-qr { position: relative; width: 58%; background: var(--papel-escuro); color: var(--tinta); border: 1.5px solid var(--tinta); padding: 1rem; display: grid; gap: .75rem; justify-items: center; text-align: center; }
  .cm-qr__vazio, .cm-qr__link { width: 100%; aspect-ratio: 1; border: 1.5px solid var(--tinta); display: grid; place-content: center; gap: .25rem; color: var(--texto-suave); text-decoration: none; }
  .cm-qr__link { color: var(--tinta); font-weight: 600; padding: .5rem; background: var(--papel); }
  .cm-qr__link img { width: 100%; height: auto; display: block; }
  .cm-qr .rotulo { font-size: .625rem; }
  .suave-tinta { color: var(--texto-suave); }
  .org, .rec { margin-top: var(--esp-bloco); }
  .org__c { display: grid; gap: .75rem; justify-items: start; align-content: start; }
  .org__c .chip { color: var(--texto-suave); min-height: 2rem; font-size: .6875rem; }
  .org__c h3 { font-weight: 600; }
  .rec { gap: 1rem; }
  .rec__c { background: var(--papel); color: var(--tinta); border: 1.5px solid var(--tinta); padding: 1.5rem; display: grid; gap: .75rem; align-content: start; }
  .rec__c img, .rec__c :global(.gravura) { width: 4rem; height: 4rem; object-fit: contain; }
  .rec__c h3 { font-weight: 600; }
  .regras { margin-block: var(--esp-bloco); }
  .regras li { padding-block: .75rem; }
  .cm-banner { display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem 3rem; align-items: center; background: var(--vinho); color: var(--papel); border: 1.5px solid var(--tinta); box-shadow: var(--sombra); padding: 2.5rem 3rem; }
  .cm-banner__estrela { font-size: 4rem; color: var(--papel); line-height: 1; }
  .cm-banner .titulo { margin-block: .25rem .5rem; }
  @media (max-width: 960px) {
    .cm-cab__in { grid-template-columns: 1fr; }
    .cm-roda { display: none; }
    .cm-so-celular { display: flex; } .cm-so-celular :global(.botao) { width: 100%; }
    .cm-breve { margin-top: var(--esp-grupo); color: var(--ouro-texto); }
    .rec { gap: var(--esp-item); }
    .rec__c { grid-template-columns: 3rem 1fr; column-gap: 1rem; padding: 1.25rem; }
    .rec__c img, .rec__c :global(.gravura) { grid-row: span 2; width: 3rem; height: 3rem; }
    .cm-banner { grid-template-columns: 1fr; gap: .875rem; padding: 1.5rem 1.25rem; box-shadow: var(--sombra-p); background: var(--papel); color: var(--tinta); }
    .cm-banner .kicker { color: var(--texto-suave); } .cm-banner :global(.botao) { width: 100%; }
    .cm-banner__estrela { display: none; }
  }
</style>
