---
import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
import Gravura from '../components/Gravura.astro';
import ProximaGira from '../components/ProximaGira.astro';
import Regencia from '../components/Regencia.astro';
import site from '../data/site.json';
import { agenda } from '../lib/gira.js';

const central = [
  { t: 'A Casa', d: 'História, regência e acervo', h: '/a-casa/', g: 'nuvem', c: 't-noite' },
  { t: 'Agenda', d: 'Giras e datas especiais', h: '/agenda/', g: 'sol', c: 't-mata' },
  { t: 'Pontos', d: 'Livro de pontos e playlists', h: '/pontos/', g: 'atabaque', c: 't-vermelho' },
  { t: 'Orações', d: 'Para rezar junto na gira e em casa', h: '/oracoes/', g: 'rosa', c: 't-estudos', menor: true },
  { t: 'Corrente', d: 'Para os médiuns da Casa', h: '/corrente/', g: 'solr', c: 't-noite' },
];
const playlists = [
  { t: 'Pontos de Baiano', g: 'coco', c: 'var(--vermelho)', claro: false },
  { t: 'Pontos de Caboclo', g: 'atabaque', c: '#E8B8A6', claro: true },
  { t: 'Discoteca da Casa', foto: '/fotos/tincoas.webp', alt: 'Capa de disco de Os Tincoãs', c: 'var(--noite)', claro: false },
  { t: 'Curimba', g: 'atabaque', c: 'var(--vinho)', claro: false },
];
const L = site.links;
import { contato, comoPedirEndereco } from '../lib/contato.js';
---
<Base>
  <!-- HERO -->
  <section class="hero t-mata" aria-labelledby="hero-t">
    <div class="hero__fundo" aria-hidden="true">
      <Gravura nome="solr" class="hero__sol" largura={480} eager />
      <Gravura nome="ramo" class="hero__ramo hero__ramo--e" largura={320} />
      <Gravura nome="ramo" class="hero__ramo hero__ramo--d" largura={320} espelhar />
    </div>
    <div class="contido hero__in">
      <div class="hero__texto">
        <p class="rotulo kicker ouro">Umbanda · Caridade · Acolhimento</p>
        <h1 id="hero-t" class="titulo">Casa de Umbanda<br /><em class="ouro display hero__nome">Pai Oxalá</em></h1>
        <p class="destaque hero__regida"><span class="ouro" aria-hidden="true">✦</span> <em>Regida pelo Caboclo Xamã</em></p>
        <p class="leitura hero__lead">Fé, caridade e ancestralidade. Giras quinzenais às sextas-feiras, abertas à assistência. Todos são bem-vindos e a entrada é gratuita.</p>
        <Botao href="/agenda/">Ver a agenda</Botao>
      </div>
      <div class="hero__card"><ProximaGira /></div>
    </div>
  </section>

  <!-- FAIXA -->
  <section class="faixa t-creme" aria-label="Informações rápidas">
    <div class="contido faixa__in">
      <div><p class="rotulo kicker-pt">Atendimento</p><p class="subtitulo">Quinzenal, às sextas</p><p class="nota suave">Todos são bem-vindos e a entrada é gratuita</p></div>
      <div><p class="rotulo kicker-pt">Horários</p><p class="subtitulo">Gira às {agenda.horarios.gira}</p><p class="nota suave">Aberta ao público.<br />Estudo mediúnico kardecista: {agenda.horarios.estudo}, só para médiuns.</p></div>
      <div><p class="rotulo kicker-pt">Onde estamos</p><p class="subtitulo">Embu-Guaçu · SP</p><p class="nota suave">{comoPedirEndereco}</p><a class="seta" href="/primeira-vez/">Orientações de visita <span aria-hidden="true">→</span></a><Botao href={contato.href} externo={contato.externo} class="faixa__cta">{contato.grupo ? 'Pedir o endereço no grupo' : 'Solicitar endereço'}</Botao></div>
    </div>
  </section>

  <!-- MEMÓRIAS -->
  <section class="secao t-papel-escuro" aria-labelledby="raizes-t">
    <div class="contido raizes">
      <div><p class="rotulo kicker suave">Memórias da Casa</p>
        <h2 id="raizes-t" class="titulo-g">Magdalena<br />e <em style="color: var(--noite)">Carlos</em></h2>
        <div class="raizes__fotos">
          <figure><img src="/fotos/magdalena.webp" width="456" height="437" loading="lazy" alt="Ialorixá Magdalena, em foto do acervo da família" /><figcaption class="nota suave">Ialorixá Magdalena</figcaption></figure>
          <figure><img src="/fotos/carlos.webp" width="456" height="437" loading="lazy" alt="Senhor Carlos, em foto do acervo da família" /><figcaption class="nota suave">Senhor Carlos</figcaption></figure>
        </div>
      </div>
      <div class="raizes__txt">
        <p class="leitura">Magdalena, Ialorixá da Casa, e Carlos, seu marido e o cambone mais dedicado, ergueram juntos este espaço com fé e trabalho, sob a proteção do Caboclo Pena Branca.</p>
        <p class="leitura raizes__leg"><em>É o legado deles que sustenta a nossa corrente até hoje.</em></p>
        <a class="seta" href="/a-casa/">Explorar história e acervo <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- CENTRAL -->
  <section class="secao" aria-labelledby="central-t">
    <div class="contido">
      <p class="rotulo kicker suave">Central da Casa</p>
      <h2 id="central-t" class="titulo-g">Tudo da Casa, <em>num só lugar</em></h2>
      <p class="destaque suave central__lead">Conheça nossa história, consulte a agenda e encontre pontos e orações para cantar e rezar.</p>
      <ul class="central">
        {central.map((c, i) => (
          <li><a class:list={['central__card', c.c]} href={c.h}>
            <span class="central__topo rotulo"><span>0{i + 1}</span><span aria-hidden="true">→</span></span>
            <Gravura nome={c.g} largura={120} class={c.menor ? 'central__g central__g--p' : 'central__g'} />
            <span class="central__txt"><span class="subtitulo">{c.t}</span><span class="nota">{c.d}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- REGÊNCIA -->
  <Regencia />

  <!-- COMUNIDADE -->
  <section class="secao" aria-labelledby="com-t">
    <div class="contido">
      <div class="banner">
        <span class="banner__estrela" aria-hidden="true">✦</span>
        <div class="banner__txt"><p class="rotulo kicker suave">Comunidade no WhatsApp</p>
          <h2 id="com-t" class="titulo">Fique <em>por perto.</em></h2>
          <p class="suave">Avisos de gira, novos materiais de estudo e playlists, direto no celular.</p></div>
        <Botao href={L.comunidade || '/comunidade/'} externo={!!L.comunidade}>Entrar na comunidade</Botao>
      </div>
    </div>
  </section>

  <!-- PLAYLISTS -->
  <section class="secao t-vermelho" aria-labelledby="pl-t">
    <div class="contido pl-wrap">
      <p class="rotulo kicker ouro">Playlists da Casa</p>
      <h2 id="pl-t" class="titulo-g">Para firmar. <em class="ouro">Para caminhar.</em></h2>
      <p class="destaque pl__lead">Pontos cantados para ouvir e aprender. Na discoteca, músicas que acompanham a corrente fora do terreiro.</p>
      <div class="pl__btns">
        {L.youtube && <Botao href={L.youtube} variante="papel" externo>YouTube</Botao>}
        {L.spotify && <Botao href={L.spotify} variante="papel" externo>Spotify</Botao>}
      </div>
      <ul class="pl">
        {playlists.map((p) => (
          <li><a href={L.youtube || '/pontos/'} class="pl__card">
            <span class="pl__capa" style={`background:${p.c};color:${p.claro ? 'var(--tinta)' : 'var(--papel)'}`}>
              {p.foto ? <img src={p.foto} alt={p.alt} width="518" height="520" loading="lazy" class="pl__foto" /> : <><Gravura nome={p.g!} largura={96} class="pl__g" /><span class="subtitulo" aria-hidden="true"><em>{p.t}</em></span></>}
            </span>
            {p.foto ? <span class="rotulo">{p.t}</span> : <span class="sr-only">{p.t}</span>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRIMEIRA VEZ -->
  <section class="contido" aria-labelledby="pv-t"><div class="pv">
    <h2 id="pv-t" class="titulo-p">Vai pela <em>primeira vez?</em></h2>
    <p class="suave">Veja como é uma gira, o que vestir e como chegar.</p>
    <div class="pv__btns"><Botao href="/primeira-vez/" variante="papel">Guia da primeira vez →</Botao><Botao href={contato.href} externo={contato.externo}>{contato.rotulo}</Botao></div>
  </div></section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; }
  .hero__fundo { position: absolute; inset: 0; pointer-events: none; }
  .hero__fundo :global(.gravura) { position: absolute; filter: grayscale(1) brightness(1.6); mix-blend-mode: screen; opacity: .28; }
  .hero__fundo :global(.hero__sol) { width: min(46vw, 640px); left: 40%; top: -8%; opacity: .35; }
  .hero__fundo :global(.hero__ramo) { width: 200px; bottom: -40px; opacity: .2; }
  .hero__fundo :global(.hero__ramo--e) { left: -60px; bottom: -100px; transform: rotate(-20deg); }
  .hero__fundo :global(.hero__ramo--d) { right: -40px; transform: scaleX(-1) rotate(-20deg); }
  .hero__in { position: relative; display: grid; grid-template-columns: 1.2fr minmax(300px, 400px); gap: var(--esp-bloco) clamp(2rem, 6vw, 6rem); align-items: center; padding-block: var(--esp-secao); }
  .hero__nome { display: block; margin-top: .1em; }
  .hero__regida { margin: var(--esp-grupo) 0; }
  .hero__lead { max-width: 34rem; margin-bottom: var(--esp-bloco); color: color-mix(in srgb, var(--papel) 88%, transparent); }

  /* FAIXA */
  .faixa__in { display: grid; grid-template-columns: repeat(3, 1fr); padding-block: var(--esp-faixa); }
  .faixa__in > div { padding-inline: var(--esp-bloco); border-left: 1px solid var(--pedra); display: grid; gap: .35rem; align-content: start; }
  .faixa__in > div:first-child { padding-left: 0; border: 0; }
  .kicker-pt::before { content: '● '; color: var(--mata); }
  .faixa .seta { margin-top: .25rem; }

  /* CENTRAL */
  .central__lead { max-width: 36rem; margin-top: var(--esp-item); }
  .central { list-style: none; padding: 0; margin: var(--esp-bloco) 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--esp-grupo); }
  .central__card { display: flex; flex-direction: column; min-height: 300px; padding: 1.25rem; text-decoration: none; border: 1.5px solid var(--tinta); box-shadow: var(--sombra); transition: transform .15s, box-shadow .15s; height: 100%; }
  .central__card:hover { transform: translate(3px, 3px); box-shadow: 3px 3px 0 var(--tinta); }
  .central__topo { display: flex; justify-content: space-between; font-size: .6875rem; }
  .central :global(.central__g) { width: 96px; margin: auto auto 1.5rem; }
  .central__txt { display: grid; gap: .35rem; }
  .central :global(.central__g--p) { width: 68px; }

  /* RAÍZES */
  .raizes { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--esp-grupo) var(--esp-secao); align-items: start; }
  .raizes__txt { display: grid; gap: var(--esp-grupo); padding-top: var(--esp-faixa); }
  .raizes__leg { color: var(--noite); }
  .raizes__fotos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--esp-grupo); margin-top: var(--esp-bloco); max-width: 30rem; }
  .raizes__fotos img { width: 100%; height: auto; border: 1.5px solid var(--tinta); box-shadow: var(--sombra-p); filter: sepia(.15); }
  .raizes__fotos figcaption { margin-top: .5rem; }
  .faixa :global(.faixa__cta) { margin-top: var(--esp-item); justify-self: start; }
  .pl__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pv__btns { display: flex; flex-direction: column; gap: var(--esp-item); align-items: stretch; }

  /* BANNER */
  .banner { display: grid; grid-template-columns: auto 1fr auto; gap: var(--esp-grupo) var(--esp-bloco); align-items: center; border: 1.5px solid var(--tinta); box-shadow: var(--sombra); padding: var(--esp-bloco) var(--esp-bloco); background: var(--papel); }
  .banner__estrela { font-size: 4rem; color: var(--ouro); line-height: 1; }
  .banner__txt .titulo { margin-bottom: .5rem; }

  /* ESTUDOS */

  /* PLAYLISTS */
  .pl__lead { max-width: 36rem; margin: var(--esp-item) 0 var(--esp-grupo); color: color-mix(in srgb, var(--papel) 88%, transparent); }
  .pl__btns { display: flex; gap: .75rem; flex-wrap: wrap; }
  .pl { list-style: none; padding: 0; margin: var(--esp-bloco) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--esp-grupo); }
  .pl__card { display: grid; gap: .75rem; text-decoration: none; }
  .pl__capa { position: relative; overflow: hidden; aspect-ratio: 1; border: 8px solid var(--papel); box-shadow: var(--sombra-p); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; text-align: center; padding: 1rem; }
  .pl :global(.pl__g) { width: 80px; }
  .pl__card > .rotulo { font-size: .6875rem; }
  .pl__card:hover .pl__capa { transform: translate(2px, 2px); }

  /* PRIMEIRA VEZ */
  .pv { display: grid; grid-template-columns: auto 1fr auto; gap: var(--esp-item) var(--esp-bloco); align-items: center; padding-block: var(--esp-cabecalho); margin-top: var(--esp-secao); border-block: 1.5px solid var(--tinta); }
  .pv p { max-width: 22rem; }

  @media (max-width: 1100px) {
    .central { grid-template-columns: repeat(6, 1fr); }
    .central > li { grid-column: span 2; }
    .central > li:nth-child(n + 4) { grid-column: span 3; }
    .pl { grid-template-columns: repeat(2, 1fr); }
    .pl__capa { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 860px) {
    .hero__in, .raizes { grid-template-columns: 1fr; }
    .hero__in { padding-bottom: 0; row-gap: var(--esp-secao); }
    .hero__card { margin-inline: calc(-1 * var(--gutter)); padding: 1.75rem var(--gutter) .75rem; background: var(--papel); }
    .hero__texto :global(.botao), .pv :global(.botao) { width: 100%; }
    .faixa__in { grid-template-columns: 1fr; gap: var(--esp-grupo); }
    .faixa__in > div { padding: 0; border: 0; }
    .central { grid-template-columns: 1fr; gap: var(--esp-item); }
    .central > li, .central > li:nth-child(n + 4) { grid-column: auto; }
    .central__card { min-height: 0; flex-direction: row; align-items: center; gap: 1rem; padding: 1rem 1.25rem; box-shadow: var(--sombra-p); }
    .central__topo { order: 3; margin-left: auto; } .central__topo span:first-child { display: none; }
    .central :global(.central__g) { width: 44px; margin: 0; order: 1; }
    .central__txt { order: 2; gap: .1rem; } .central__txt .subtitulo { font-size: 1.25rem; }
    .raizes__txt { padding-top: 0; }
    .banner { grid-template-columns: 1fr; gap: var(--esp-grupo); padding: var(--esp-colada) var(--esp-grupo); }
    .banner__estrela { display: none; }
    .pl { grid-template-columns: 1fr 1fr; gap: var(--esp-item); }
    .pl-wrap { display: flex; flex-direction: column; } .pl-wrap .pl { order: 1; margin-top: var(--esp-grupo); } .pl-wrap > * { order: 0; } .pl-wrap .pl__btns { order: 2; margin-top: var(--esp-grupo); }
    .pl__capa { border-width: 5px; aspect-ratio: 1; } .pl__capa .subtitulo { font-size: 1rem; } .pl :global(.pl__g) { width: 44px; }
    .faixa :global(.faixa__cta) { justify-self: stretch; }
    .pv { grid-template-columns: 1fr; gap: var(--esp-item); border-bottom: 0; }
  }
</style>
