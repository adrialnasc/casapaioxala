---
import Base from '../layouts/Base.astro';
import EstadoVazio from '../components/EstadoVazio.astro';
---
<Base titulo="Página não encontrada · Casa de Umbanda Pai Oxalá" descricao="Esta página não existe mais ou mudou de endereço.">
  <section class="secao erro">
    <div class="contido">
      <EstadoVazio nivel="h1" gravura="barco" titulo="Essa página<br />se perdeu no mar." texto="O caminho de volta é por aqui." acao="Voltar ao início" href="/" />
      <nav class="erro__atalhos" aria-label="Outras páginas">
        <a class="seta" href="/agenda/">Agenda</a><a class="seta" href="/pontos/">Pontos</a><a class="seta" href="/estudos/">Estudos</a><a class="seta" href="/primeira-vez/">Primeira vez</a>
      </nav>
    </div>
  </section>
</Base>
<style>
  .erro { min-height: 60vh; display: grid; align-content: center; }
  .erro__atalhos { display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: var(--esp-grupo); }
</style>
